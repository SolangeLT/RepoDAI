1. Obtén todos los chismes registrados
SELECT *
FROM chismes;


2. Muestra solo los chismes reales
SELECT *
FROM chismes
WHERE es_real = 1;


3. Encuentra los chismes inventados
SELECT *
FROM chismes
WHERE es_real = 0;


4. Chismes con monto de silencio mayor a 500
SELECT *
FROM chismes
WHERE monto_silencio > 500;


5. Chismes con gravedad mayor o igual a 4
SELECT quien_dijo, sobre_quien, chisme, nivel_gravedad
FROM chismes
WHERE nivel_gravedad >= 4;


6. Chismes sobre una persona específica llamada Ana
SELECT sobre_quien, chisme, quien_dijo
FROM chismes
WHERE sobre_quien = 'Ana';


7. Chismes contados por persona que los dijo
SELECT quien_dijo,
       COUNT(*) AS total_chismes_dichos
FROM chismes
GROUP BY quien_dijo
ORDER BY total_chismes_dichos DESC;


8. Chismes contados por persona involucrada
SELECT sobre_quien AS persona_involucrada,
       COUNT(*) AS total_chismes_recibidos
FROM chismes
GROUP BY sobre_quien
ORDER BY total_chismes_recibidos DESC;


9. Chismes ocurridos entre dos fechas
SELECT chisme, fecha
FROM chismes
WHERE fecha BETWEEN '2024-01-01' AND '2024-12-31';


10. Cuántos chismes se dijeron por año
SELECT strftime('%Y', fecha) AS anio,
       COUNT(*) AS total_chismes
FROM chismes
GROUP BY strftime('%Y', fecha)
ORDER BY anio;


11. Cuántos chismes se dijeron por año solo en enero
SELECT strftime('%Y', fecha) AS anio,
       COUNT(*) AS total_chismes_en_enero
FROM chismes
WHERE strftime('%m', fecha) = '01'
GROUP BY strftime('%Y', fecha)
ORDER BY anio;


12. Cuántos chismes se dijeron por mes
SELECT strftime('%m', fecha) AS mes,
       COUNT(*) AS total_chismes
FROM chismes
GROUP BY strftime('%m', fecha)
ORDER BY mes;


13. Chismes agrupados por año y mes
SELECT strftime('%Y', fecha) AS anio,
       strftime('%m', fecha) AS mes,
       COUNT(*) AS total_chismes
FROM chismes
GROUP BY strftime('%Y', fecha), strftime('%m', fecha)
ORDER BY anio, mes;


14. Años donde se dijeron más de 10 chismes
SELECT strftime('%Y', fecha) AS anio,
       COUNT(*) AS total_chismes
FROM chismes
GROUP BY strftime('%Y', fecha)
HAVING COUNT(*) > 10;


15. Años donde se dijeron más de 12 chismes
SELECT strftime('%Y', fecha) AS anio,
       COUNT(*) AS total_chismes
FROM chismes
GROUP BY strftime('%Y', fecha)
HAVING COUNT(*) > 12;


16. Suma total de dinero pagado por silencio
SELECT SUM(monto_silencio) AS total_pagado_silencio
FROM chismes;


17. Promedio del monto de silencio
SELECT AVG(monto_silencio) AS promedio_monto_silencio
FROM chismes;


18. Promedio de gravedad por categoría
SELECT categoria,
       AVG(nivel_gravedad) AS promedio_gravedad
FROM chismes
GROUP BY categoria
ORDER BY promedio_gravedad DESC;


19. Categorías con más de 5 chismes
SELECT categoria,
       COUNT(*) AS total_chismes
FROM chismes
GROUP BY categoria
HAVING COUNT(*) > 5;


20. Personas que recibieron más de 1000 en pagos de silencio
SELECT sobre_quien AS persona,
       SUM(monto_silencio) AS total_recibido
FROM chismes
GROUP BY sobre_quien
HAVING SUM(monto_silencio) > 1000;


21. Chismes con testigos distintos de cero
SELECT *
FROM chismes
WHERE testigos <> 0;


22. Chismes de gravedad entre 2 y 4
SELECT *
FROM chismes
WHERE nivel_gravedad BETWEEN 2 AND 4;


23. Chismes de la categoría trabajo
SELECT *
FROM chismes
WHERE LOWER(categoria) = 'trabajo';


24. Chismes contados por lugar
SELECT lugar,
       COUNT(*) AS total_chismes
FROM chismes
GROUP BY lugar
ORDER BY total_chismes DESC;


25. Lugares donde se dijeron más de 3 chismes
SELECT lugar,
       COUNT(*) AS total_chismes
FROM chismes
GROUP BY lugar
HAVING COUNT(*) > 3;


26. Personas que dijeron chismes con promedio de gravedad mayor a 3
SELECT quien_dijo,
       AVG(nivel_gravedad) AS promedio_gravedad
FROM chismes
GROUP BY quien_dijo
HAVING AVG(nivel_gravedad) > 3
ORDER BY promedio_gravedad DESC;
