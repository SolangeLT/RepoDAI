10. Actores de las películas que hayan sido vistas por usuarios de España

SELECT DISTINCT
    a.nombre AS actor,
    p.titulo AS pelicula
FROM Usuarios u
JOIN Paises pa
    ON u.pais_id = pa.id
JOIN Reproducciones r
    ON u.id = r.usuario_id
JOIN Peliculas p
    ON r.pelicula_id = p.id
JOIN PeliculaActor pac
    ON p.id = pac.pelicula_id
JOIN Actores a
    ON pac.actor_id = a.id
WHERE pa.nombre = 'España'
ORDER BY a.nombre;
